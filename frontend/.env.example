# SheWings Foundation Attendance Management System - Frontend Environment Configuration
# Copy this file to .env.local for local development, or set these variables in your hosting provider (e.g. Vercel)

# Production Backend API URL (must include /api suffix)
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# Production Backend Origin (used for uploaded selfies and media assets)
NEXT_PUBLIC_BACKEND_URL=https://your-backend-api.onrender.com

# SheWings Foundation Attendance Management System - Backend Environment Configuration
# Copy this file to .env for local development or configure these environment variables on your cloud provider

# Server Configuration
PORT=5000
NODE_ENV=production

# -------------------------------------------------------------
# MySQL Database Configuration
# Option A: Standard Individual Variables
# -------------------------------------------------------------
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=shewings_attendance
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Option B: Cloud MySQL Connection URI (e.g. Render, Railway, TiDB Cloud, Aiven)
# If provided, DATABASE_URL takes precedence over individual DB_* variables
# DATABASE_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED

# -------------------------------------------------------------
# JWT Authentication Configuration
# Generate a secure 32+ character random string in production
# -------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# Initial / Root Administrator Credentials
# (Used when running initial database migration and seeding)
# -------------------------------------------------------------
ADMIN_EMAIL=admin@shewings.org
ADMIN_PASSWORD=SetAStrongInitialPasswordHere123!

# -------------------------------------------------------------
# Frontend CORS Allowlist
# Comma-separated origins allowed to make API requests
# -------------------------------------------------------------
FRONTEND_URL=https://your-frontend-app.vercel.app,http://localhost:3000

# -------------------------------------------------------------
# Persistent Selfie & Biometric Media Storage (Recommended for Production)
# Option A: Cloudinary Free Tier (25 GB permanent storage, ₹0 budget, persistent across redeployments)
# -------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_FOLDER=shewings_selfies

# Option B: Persistent Disk Mount (for VPS, Docker Volume, or Railway Disk)
# UPLOADS_DIR=/var/data/uploads

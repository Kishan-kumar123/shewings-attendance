# Root .gitignore for SheWings Foundation Attendance Management System

# Environment variables & secrets (NEVER COMMIT SECRETS OR PASSWORDS)
.env
.env.local
.env.*.local
*.env
backend/.env
backend/.env.local
backend/.env.*.local
frontend/.env
frontend/.env.local
frontend/.env*.local
!.env.example
!backend/.env.example
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Next.js Build Artifacts & Caches
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
build/
dist/

# Uploaded selfies & Private Biometric Photos (preserve placeholder SVG)
backend/uploads/selfies/*.jpg
backend/uploads/selfies/*.jpeg
backend/uploads/selfies/*.png
backend/uploads/selfies/*.webp
uploads/selfies/*.jpg
uploads/selfies/*.jpeg
uploads/selfies/*.png
uploads/selfies/*.webp
!backend/uploads/placeholder-selfie.svg
!uploads/placeholder-selfie.svg

# Server Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/
logs/

# Database dumps and CSV exports (preserve schema.sql)
*.sql
*.csv
!backend/database/schema.sql

# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
.vercel
